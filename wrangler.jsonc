{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diceclue",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-23",
  "observability": {
    "enabled": true
  },
  // Build before deploy (previously done implicitly by wrangler autoconfig).
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Run the Worker before asset matching so the workers.dev 301 applies to every path.
    "run_worker_first": true
  }
}
